#!/bin/bash
xinput set-prop 11 364 0, 0
xinput set-prop 11 319 1
xinput set-prop 11 339 1
xinput set-prop 13 371 1
xinput set-prop 12 371 1
xinput set-prop 12 369 1
xinput set-prop 11 347 0
wal -R -n 
feh --bg-scale Downloads/wp4877200-dune-2020-wallpapers.jpg
setxkbmap de
.config/polybar/docky/./launch.sh
#test
