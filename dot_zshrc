### theme.sh switching

# Custom theme switching for sudo/long commands
oldsu() {
	(
		INHIBIT_THEME_HIST=1 theme.sh red-alert
		trap 'theme.sh "$(theme.sh -l|tail -n1)"' INT
		command su "$@"
		theme.sh "$(theme.sh -l|tail -n1)"
	)
}

oldsudo() {
	(
		pid=$(exec sh -c 'echo "$PPID"')

		(
				sleep .2s
				ps -p "$pid" > /dev/null && INHIBIT_THEME_HIST=1 theme.sh red-alert
		) &

		trap 'theme.sh "$(theme.sh -l|tail -n1)"' INT
		command sudo "$@"
		theme.sh "$(theme.sh -l|tail -n1)"
	)
}

# ssh theme switching
oldssh() {
  # Enhanced SSH theme handler with proper argument parsing
  local host_raw host theme

  # Parse SSH arguments to find hostname
  while [[ $# -gt 0 ]]; do
    case $1 in
      -*)
        shift  # Skip option and its argument
        [[ $1 != -* ]] && shift
        ;;
      *)
        host_raw=$1
        break
        ;;
    esac
  done

  host="${host_raw#*@}"  # Remove username if present

  # Find theme using exact match
  theme=$(awk -F': *' -v h="$host" '
    $1 == h {print $2; exit}
    $1 == host_raw {print $2; exit}  # Try raw host with username
  ' ~/.ssh_themes)

  if [[ -n "$theme" ]]; then
    (
      INHIBIT_THEME_HIST=1 theme.sh "$theme"
      trap 'theme.sh "$(theme.sh -l | tail -n1)"' INT
      command ssh "$@"
      theme.sh "$(theme.sh -l | tail -n1)"
    )
  else
    command ssh "$@"
  fi
}

